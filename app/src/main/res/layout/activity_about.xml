<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <!-- Video de fondo en bucle (res/raw/about_bg.mp4) -->
    <VideoView
        android:id="@+id/videoAboutBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"/>

    <!-- Veladura oscura para legibilidad del texto -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAboutClose"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Cerrar"
            android:textColor="@android:color/white"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Romaster LiveWall Engine"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/textAboutVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:text="Motor y editor de live wallpapers para Android.\nVideo, overlay, capas de imagen, reloj avanzado y reproducción reactiva al bloqueo del dispositivo."
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:text="Desarrollado por Román Ignacio Romero (Romaster).\nGracias por usar la app. Si te gusta el proyecto, podés apoyarlo o escribirme."
                    android:textColor="#E0FFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:text="Contacto y redes"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                    <ImageButton
                        android:id="@+id/buttonAboutInstagram"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_margin="5dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Instagram"
                        android:scaleType="fitCenter"
                        android:src="@drawable/about_ic_instagram"
                        android:padding="4dp"/>

                    <ImageButton
                        android:id="@+id/buttonAboutThreads"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_margin="5dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Threads"
                        android:scaleType="fitCenter"
                        android:src="@drawable/about_ic_threads"
                        android:padding="4dp"/>

                    <ImageButton
                        android:id="@+id/buttonAboutYoutube"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_margin="5dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="YouTube"
                        android:scaleType="fitCenter"
                        android:src="@drawable/about_ic_youtube"
                        android:padding="4dp"/>

                    <ImageButton
                        android:id="@+id/buttonAboutGithub"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_margin="5dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="GitHub"
                        android:scaleType="fitCenter"
                        android:src="@drawable/about_ic_github"
                        android:padding="4dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                    <ImageButton
                        android:id="@+id/buttonAboutReddit"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_margin="5dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Reddit"
                        android:scaleType="fitCenter"
                        android:src="@drawable/about_ic_reddit"
                        android:padding="4dp"/>

                    <ImageButton
                        android:id="@+id/buttonAboutPatreon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_margin="5dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Patreon"
                        android:scaleType="fitCenter"
                        android:src="@drawable/about_ic_patreon"
                        android:padding="4dp"/>

                    <ImageButton
                        android:id="@+id/buttonAboutGmail"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_margin="5dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Correo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/about_ic_gmail"
                        android:padding="4dp"/>

                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="Instagram · Threads · YouTube · GitHub&#10;Reddit · Patreon · Gmail"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"
                    android:background="#40FFFFFF"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Apoyar el proyecto"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/buttonAboutBmc"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Buy me a coffee"
                    android:scaleType="fitCenter"
                    android:src="@drawable/about_ic_bmc"
                    android:padding="4dp"/>

                <TextView
                    android:id="@+id/textAboutBmcLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="#FFDD00"
                    android:text="🍺  Invítame una cerveza"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="24dp"
                    android:text="© 2026 Román Ignacio Romero (Romaster)\nLicencia Apache 2.0"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
